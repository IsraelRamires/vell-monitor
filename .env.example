# Copie para .env (ou cadastre no painel do serviço de hospedagem) e preencha.
# Nada aqui é obrigatório: sem estas variáveis o monitor roda como no seu PC.

# Endereço do servidor da BSC com histórico completo. Crie uma chave grátis em
# https://nodereal.io e troque a parte final pela sua.
VELL_RPC_ARCHIVE=https://bsc-mainnet.nodereal.io/v1/SUA_CHAVE_AQUI

# 0.0.0.0 = aceita acessos de fora (necessário online). No PC deixe 127.0.0.1.
VELL_HOST=0.0.0.0

# Porta. Railway e Render definem PORT sozinhos; não precisa preencher lá.
PORT=8765

# Onde guardar o banco. Online, aponte para o disco permanente (ex.: /data/vell.db).
VELL_DB=/data/vell.db

# 1 = não abrir o navegador ao iniciar.
VELL_SEM_NAVEGADOR=1
